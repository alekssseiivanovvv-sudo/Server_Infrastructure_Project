scope: {{ patroni_cluster_name }}
namespace: /service/
name: {{ inventory_hostname }}
restapi:
  listen: {{ ansible_host }}:8008
  connect_address: {{ ansible_host }}:8008
  authentication:
    username: patroni_admin
    password: {{ vault_patroni_api_password | to_json }}
ctl:
  authentication:
    username: patroni_admin
    password: {{ vault_patroni_api_password | to_json }}
etcd3:
  hosts: [{% for host in groups['etcd_servers'] %}"{{ hostvars[host].ansible_host }}:2379"{{ ', ' if not loop.last else '' }}{% endfor %}]
bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    check_timeline: true
    synchronous_mode: false
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        wal_level: replica
        hot_standby: 'on'
        wal_keep_size: 256MB
        max_slot_wal_keep_size: 2GB
        max_wal_senders: 10
        max_replication_slots: 10
  initdb:
    - encoding: UTF8
    - data-checksums
postgresql:
  listen: {{ ansible_host }}:5432
  connect_address: {{ ansible_host }}:5432
  data_dir: {{ patroni_data_dir }}
  bin_dir: /usr/lib/postgresql/{{ postgres_major_version }}/bin
  pgpass: /var/lib/postgresql/.pgpass-patroni
  authentication:
    superuser:
      username: postgres
      password: {{ vault_postgres_superuser_password | to_json }}
    replication:
      username: {{ postgres_replication_user }}
      password: {{ vault_postgres_replication_password | to_json }}
  parameters:
    unix_socket_directories: /var/run/postgresql
  pg_hba:
    - local all all peer
{% for host in groups['patroni_servers'] %}
    - host replication {{ postgres_replication_user }} {{ hostvars[host].ansible_host }}/32 scram-sha-256
    - host all postgres {{ hostvars[host].ansible_host }}/32 scram-sha-256
{% endfor %}
{% for host in groups['balance_servers'] %}
    - host {{ postgres_app_database }} {{ postgres_app_user }} {{ hostvars[host].ansible_host }}/32 scram-sha-256
    - host {{ postgres_app_database }} {{ postgres_backup_user }} {{ hostvars[host].ansible_host }}/32 scram-sha-256
{% endfor %}
{% for host in groups['backup_storage_servers'] %}
    - host {{ postgres_app_database }} {{ postgres_backup_user }} {{ hostvars[host].ansible_host }}/32 scram-sha-256
{% endfor %}
{% for address in data_extra_client_ipv4 %}
    - host {{ postgres_app_database }} {{ postgres_app_user }} {{ address }}/32 scram-sha-256
    - host {{ postgres_app_database }} {{ postgres_backup_user }} {{ address }}/32 scram-sha-256
{% endfor %}
tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false
