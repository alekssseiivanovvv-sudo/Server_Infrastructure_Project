#!/usr/sbin/nft -f

destroy table inet lab_router

table inet lab_router {
  set project_lans {
    type ipv4_addr;
    flags interval;
    elements = { {{ router_firewall_project_subnets | join(', ') }} };
  }

  chain input {
    type filter hook input priority 0; policy drop;

    iifname != "{{ router_firewall_tailscale_interface }}" tcp dport { 22, {{ router_firewall_ssh_port }} } drop

    ct state invalid drop
    ct state established,related accept
    iifname "lo" accept

    meta l4proto { icmp, ipv6-icmp } accept

    iifname "{{ router_firewall_tailscale_interface }}" tcp dport {{ router_firewall_ssh_port }} accept

    iifname "{{ router_firewall_wan_interface }}" udp sport 67 udp dport 68 accept
    iifname "{{ router_firewall_wan_interface }}" udp dport 41641 accept

    iifname "{{ router_firewall_lan_interface }}" ip saddr {{ router_firewall_lan_subnets[inventory_hostname] }} ip daddr {{ router_firewall_lan_addresses[inventory_hostname] }} udp dport 53 accept
    iifname "{{ router_firewall_lan_interface }}" ip saddr {{ router_firewall_lan_subnets[inventory_hostname] }} ip daddr {{ router_firewall_lan_addresses[inventory_hostname] }} tcp dport 53 accept

    ip saddr @project_lans tcp dport 9100 accept
    iifname "{{ router_firewall_tailscale_interface }}" tcp dport 9100 accept
  }

  chain mangle_forward {
    type filter hook forward priority mangle; policy accept;

    oifname "{{ router_firewall_tailscale_interface }}" tcp flags syn tcp option maxseg size set rt mtu
  }

  chain forward {
    type filter hook forward priority 0; policy drop;

    ct state invalid drop
    ct state established,related accept

    iifname "{{ router_firewall_lan_interface }}" oifname "{{ router_firewall_wan_interface }}" ip saddr {{ router_firewall_lan_subnets[inventory_hostname] }} accept
    iifname "{{ router_firewall_lan_interface }}" oifname "{{ router_firewall_tailscale_interface }}" ip saddr {{ router_firewall_lan_subnets[inventory_hostname] }} accept
    iifname "{{ router_firewall_tailscale_interface }}" oifname "{{ router_firewall_lan_interface }}" ip daddr {{ router_firewall_lan_subnets[inventory_hostname] }} accept
  }

  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;

    oifname "{{ router_firewall_wan_interface }}" ip saddr {{ router_firewall_lan_subnets[inventory_hostname] }} masquerade
  }
}
