{
  "identities": [
    {
      "name": "s3-bootstrap-admin",
      "credentials": [
        {
          "accessKey": {{ vault_seaweed_admin_access_key | to_json }},
          "secretKey": {{ vault_seaweed_admin_secret_key | to_json }}
        }
      ],
      "actions": [
        "Admin",
        "Read",
        "Write",
        "List",
        "Tagging"
      ]
    },
    {
      "name": "shop-app",
      "credentials": [
        {
          "accessKey": {{ vault_shop_seaweed_access_key | to_json }},
          "secretKey": {{ vault_shop_seaweed_secret_key | to_json }}
        }
      ],
      "actions": [
        "Read:product-images",
        "Write:product-images",
        "List:product-images"
      ]
    }
  ]
}
