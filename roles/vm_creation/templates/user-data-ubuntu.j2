#cloud-config
hostname: {{ vm_name | replace('_', '-') | to_json }}
manage_etc_hosts: true

users:
  - name: {{ selected_admin_users[0].name | to_json }}
    groups: [sudo]
    shell: /bin/bash
    lock_passwd: false
    hashed_passwd: {{ selected_admin_users[0].password_hash | to_json }}
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - {{ lookup('ansible.builtin.file', '~/.ssh/ansible.pub') | trim | to_json }}

disable_root: true
ssh_pwauth: false

growpart:
  mode: auto
  devices: ["/"]

resize_rootfs: true

package_update: true
package_upgrade: false

packages:
  - openssh-server
  - sudo
  - python3
{% if vm_name in ['east_storage', 'west_storage'] %}
  - mdadm
{% endif %}

write_files:
  - path: /etc/ssh/sshd_config.d/00-ansible-bootstrap.conf
    owner: root:root
    permissions: "0644"
    content: |
      Port {{ vault_ssh_port }}
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no

runcmd:
{% if vm_name in ['east_storage', 'west_storage'] %}
  - |
      set -eu
      DISK1=/dev/disk/by-id/virtio-data1
      DISK2=/dev/disk/by-id/virtio-data2

      while [ ! -e "$DISK1" ] || [ ! -e "$DISK2" ]; do
        sleep 1
      done

      if [ ! -e /dev/md0 ]; then
        mdadm --create /dev/md0 --level=1 --raid-devices=2 "$DISK1" "$DISK2"
      fi

      if ! blkid /dev/md0 >/dev/null 2>&1; then
        mkfs.ext4 -L storage /dev/md0
      fi

      mkdir -p /srv/storage
      UUID=$(blkid -s UUID -o value /dev/md0)

      if ! grep -q "UUID=$UUID " /etc/fstab; then
        echo "UUID=$UUID /srv/storage ext4 defaults,nofail 0 2" >> /etc/fstab
      fi

      mdadm --detail --scan > /etc/mdadm/mdadm.conf
      update-initramfs -u
      mount /srv/storage
{% endif %}
  - [systemctl, enable, --now, ssh]
  - [sh, -c, '/usr/sbin/sshd -t && systemctl reload ssh']
