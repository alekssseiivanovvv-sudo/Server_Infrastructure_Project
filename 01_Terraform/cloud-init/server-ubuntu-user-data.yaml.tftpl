#cloud-config server ubuntu
hostname: ${jsonencode(hostname)}
manage_etc_hosts: true

users:
  - name: ansible_admin
    groups: [sudo]
    shell: /bin/bash
    lock_passwd: true
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${jsonencode(ssh_public_key)}

disable_root: true
ssh_pwauth: false

growpart:
  mode: auto
  devices: ["/"]

resize_rootfs: true

package_update: true
package_upgrade: false

packages:
  - openssh-server
  - sudo
  - python3

write_files:
  - path: /etc/ssh/sshd_config.d/00-ansible-bootstrap.conf
    owner: root:root
    permissions: "0644"
    content: |
      Port ${ssh_port}
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PubkeyAuthentication yes
      AllowUsers ansible_admin

runcmd:
  - |
      set -eu

      SWAP_MB=${swap_size_mb}

      if [ "$SWAP_MB" -gt 0 ] && [ ! -f /swapfile ]; then
        fallocate -l "$${SWAP_MB}M" /swapfile || dd if=/dev/zero of=/swapfile bs=1M count="$SWAP_MB"
        chmod 600 /swapfile
        mkswap /swapfile
      fi

      if [ -f /swapfile ]; then
        if ! grep -q '^/swapfile ' /etc/fstab; then
          echo '/swapfile none swap sw 0 0' >> /etc/fstab
        fi
        swapon --show=NAME | grep -qx /swapfile || swapon /swapfile
      fi
  - [systemctl, enable, --now, ssh]
  - [sh, -c, '/usr/sbin/sshd -t && systemctl reload ssh']
