#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

readonly BACKUP_MOUNT=/srv/backup
readonly RCLONE_CONFIG={{ backup_rclone_config_file | quote }}
readonly RESTIC_PASSWORD_PATH={{ backup_restic_password_file | quote }}
readonly RESTIC_CACHE={{ backup_cache_dir | quote }}
readonly LOCK_FILE={{ backup_global_lock_file | quote }}
readonly STATUS_DIRECTORY={{ backup_status_dir | quote }}

readonly IMAGES_SOURCE={{ (backup_s3_remote_name ~ ':' ~ backup_images_bucket) | quote }}
readonly IMAGES_STAGING={{ (backup_staging_dir ~ '/product-images') | quote }}
readonly IMAGES_REPOSITORY={{ backup_images_repository | quote }}

readonly LOGS_SOURCE={{ (backup_s3_remote_name ~ ':' ~ backup_logs_bucket) | quote }}
readonly LOGS_STAGING={{ (backup_staging_dir ~ '/loki-logs') | quote }}
readonly LOGS_REPOSITORY={{ backup_logs_repository | quote }}

export RESTIC_PASSWORD_FILE="$RESTIC_PASSWORD_PATH"
export XDG_CACHE_HOME="$RESTIC_CACHE"

log() {
  printf '[s3-backup] %s\n' "$*"
}

fail() {
  log "ERROR: $*"
  exit 1
}

cleanup() {
  local exit_code=$?

  trap - EXIT

  if [[ "$exit_code" -ne 0 ]]; then
    date -u +'%Y-%m-%dT%H:%M:%SZ' >"${STATUS_DIRECTORY}/s3.last-failure"
    log 'Backup failed'
  fi

  exit "$exit_code"
}

backup_bucket() {
  local source=$1
  local staging=$2
  local repository=$3
  local data_tag=$4

  log "Synchronizing $source"
  rclone --config "$RCLONE_CONFIG" sync "$source" "$staging"

  log "Saving $source to Restic"
  restic --repo "$repository" backup "$staging" \
    --host garage-cluster \
    --tag s3 \
    --tag "$data_tag"
}

main() {
  mountpoint -q "$BACKUP_MOUNT" || fail "$BACKUP_MOUNT is not mounted"
  [[ -r "$RCLONE_CONFIG" ]] || fail 'rclone configuration is not readable'
  [[ -r "$RESTIC_PASSWORD_FILE" ]] || fail 'Restic password file is not readable'
  [[ -f "${IMAGES_REPOSITORY}/config" ]] || fail 'Images Restic repository is not initialized'
  [[ -f "${LOGS_REPOSITORY}/config" ]] || fail 'Logs Restic repository is not initialized'

  exec 9>"$LOCK_FILE"
  flock -n 9 || fail 'Another backup or maintenance job is already running'

  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  backup_bucket "$IMAGES_SOURCE" "$IMAGES_STAGING" "$IMAGES_REPOSITORY" product-images
  backup_bucket "$LOGS_SOURCE" "$LOGS_STAGING" "$LOGS_REPOSITORY" loki-logs

  date -u +'%Y-%m-%dT%H:%M:%SZ' >"${STATUS_DIRECTORY}/s3.last-success"
  rm -f "${STATUS_DIRECTORY}/s3.last-failure"

  log 'S3 backup completed successfully'
}

main "$@"
