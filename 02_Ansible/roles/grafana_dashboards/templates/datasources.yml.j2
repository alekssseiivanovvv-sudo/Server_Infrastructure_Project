apiVersion: 1

# Remove datasource definitions created by the former monitoring_server
# provisioning file before creating the canonical definitions below.
deleteDatasources:
  - name: Prometheus
    orgId: 1
  - name: Loki
    orgId: 1

datasources:
  - name: Prometheus
    uid: prometheus-uid
    type: prometheus
    access: proxy
    url: http://localhost:9090
    isDefault: true
    editable: false
    version: 1
    jsonData:
      timeInterval: "15s"

  - name: Loki
    uid: loki-uid
    type: loki
    access: proxy
    url: http://localhost:3100
    editable: false
    version: 1
