[Unit]
Description=SeaweedFS Filer
After=network-online.target seaweed-master.service seaweed-volume.service
Wants=network-online.target seaweed-master.service seaweed-volume.service

[Service]
User={{ seaweed_admin_user }}
Group={{ seaweed_admin_user }}
ExecStart=/usr/local/bin/weed filer -master=127.0.0.1:9333 -ip=127.0.0.1 -ip.bind=127.0.0.1 -port=8888 -port.grpc=18888 -defaultStoreDir={{ seaweed_data_dir }}/filer
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
