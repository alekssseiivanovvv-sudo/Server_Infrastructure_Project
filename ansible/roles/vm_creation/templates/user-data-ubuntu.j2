#cloud-config
hostname: {{ vm_name | replace('_', '-') | to_json }}
manage_etc_hosts: true

users:
  - name: {{ selected_admin_users[0].name | to_json }}
    groups: [sudo]
    shell: /bin/bash
    lock_passwd: false
    hashed_passwd: {{ selected_admin_users[0].password_hash | to_json }}
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - {{ lookup('ansible.builtin.file', '~/.ssh/ansible.pub') | trim | to_json }}

disable_root: true
ssh_pwauth: false

growpart:
  mode: auto
  devices: ["/"]

resize_rootfs: true

package_update: true
package_upgrade: false

packages:
  - openssh-server
  - sudo
  - python3
{% if vm_name in ['east_storage', 'west_storage'] %}
  - mdadm
{% endif %}

write_files:
  - path: /etc/ssh/sshd_config.d/00-ansible-bootstrap.conf
    owner: root:root
    permissions: "0644"
    content: |
      Port {{ vault_ssh_port }}
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no

runcmd:
{% if vm_name in ['east_storage', 'west_storage'] %}
  - |
      set -eu

      DISK1=/dev/disk/by-id/virtio-data1
      DISK2=/dev/disk/by-id/virtio-data2

      udevadm settle --timeout=30

      ATTEMPT=0
      while [ ! -b "$DISK1" ] || [ ! -b "$DISK2" ]; do
        ATTEMPT=$((ATTEMPT + 1))
        if [ "$ATTEMPT" -ge 60 ]; then
          echo "Storage disks data1 and data2 were not found" >&2
          exit 1
        fi
        sleep 1
      done

      if [ ! -b /dev/md0 ]; then
        if mdadm --examine "$DISK1" >/dev/null 2>&1 || mdadm --examine "$DISK2" >/dev/null 2>&1; then
          mdadm --assemble /dev/md0 "$DISK1" "$DISK2"
        else
          printf 'yes\n' | mdadm --create /dev/md0 \
            --metadata=1.2 \
            --level=1 \
            --raid-devices=2 \
            "$DISK1" "$DISK2"
        fi
      fi

      FILESYSTEM=$(blkid -s TYPE -o value /dev/md0 2>/dev/null || true)

      if [ -z "$FILESYSTEM" ]; then
        mkfs.ext4 -L storage /dev/md0
      elif [ "$FILESYSTEM" != "ext4" ]; then
        echo "/dev/md0 contains unexpected filesystem: $FILESYSTEM" >&2
        exit 1
      fi

      mkdir -p /srv/storage
      UUID=$(blkid -s UUID -o value /dev/md0)

      if ! grep -q "UUID=$UUID " /etc/fstab; then
        echo "UUID=$UUID /srv/storage ext4 defaults,nofail 0 2" >> /etc/fstab
      fi

      ARRAY_LINE=$(mdadm --detail --scan)
      if ! grep -qF "$ARRAY_LINE" /etc/mdadm/mdadm.conf; then
        echo "$ARRAY_LINE" >> /etc/mdadm/mdadm.conf
      fi

      update-initramfs -u
      mountpoint -q /srv/storage || mount /srv/storage

      mdadm --detail /dev/md0
      cat /proc/mdstat
{% endif %}
  - [systemctl, enable, --now, ssh]
  - [sh, -c, '/usr/sbin/sshd -t && systemctl reload ssh']
