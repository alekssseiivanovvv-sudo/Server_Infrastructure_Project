[Unit]
Description=SeaweedFS S3 {{ inventory_hostname }}
After=network-online.target seaweed-filer.service
Wants=network-online.target

[Service]
User={{ seaweed_admin_user }}
Group={{ seaweed_admin_user }}
ExecStart=/usr/local/bin/weed s3 -filer={{ ansible_host }}:8888 -ip.bind={{ ansible_host }} -port=8333 -config={{ seaweed_s3_config_file }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
