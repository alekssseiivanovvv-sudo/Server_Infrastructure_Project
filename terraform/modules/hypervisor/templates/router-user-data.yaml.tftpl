#cloud-config
hostname: ${jsonencode(hostname)}
manage_etc_hosts: true

users:
  - name: ansible_admin
    groups: [wheel]
    shell: /bin/ash
    lock_passwd: false
    hashed_passwd: ${jsonencode(admin_password_hash)}
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${jsonencode(ansible_public_key)}

disable_root: true
ssh_pwauth: false

growpart:
  mode: auto
  devices: ["/"]

resize_rootfs: true

write_files:
  - path: /etc/apk/repositories
    permissions: "0644"
    content: |
      https://dl-cdn.alpinelinux.org/alpine/v3.24/main
      https://dl-cdn.alpinelinux.org/alpine/v3.24/community

  - path: /root/tailscale-auth-key
    permissions: "0600"
    content: ${jsonencode(tailscale_auth_key)}

  - path: /etc/sysctl.d/99-router.conf
    permissions: "0644"
    content: |
      net.ipv4.ip_forward = 1

  - path: /etc/ssh/sshd_config
    permissions: "0600"
    content: |
      Port ${ssh_port}
      ListenAddress 127.0.0.1
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PubkeyAuthentication yes
      AuthorizedKeysFile .ssh/authorized_keys
      AllowUsers ansible_admin
      Subsystem sftp internal-sftp

  - path: /etc/conf.d/sshd
    append: true
    defer: true
    permissions: "0644"
    content: |

      rc_need="nftables"

  - path: /etc/nftables.nft
    defer: true
    permissions: "0600"
    content: |
      add table inet lab_router
      flush table inet lab_router

      table inet lab_router {
        chain input {
          type filter hook input priority 0; policy drop;

          iifname != "tailscale0" tcp dport { 22, ${ssh_port} } drop

          ct state invalid drop
          ct state established,related accept
          iifname "lo" accept

          iifname "tailscale0" tcp dport ${ssh_port} accept
          iifname "eth0" udp sport 67 udp dport 68 accept
          iifname "eth0" udp dport 41641 accept
          meta l4proto { icmp, ipv6-icmp } accept
        }

        chain mangle_forward {
          type filter hook forward priority mangle; policy accept;
          oifname "tailscale0" tcp flags syn tcp option maxseg size set rt mtu
        }

        chain forward {
          type filter hook forward priority 0; policy drop;

          ct state invalid drop
          ct state established,related accept
          iifname "eth1" oifname "eth0" ip saddr ${lan_subnet} accept
          iifname "eth1" oifname "tailscale0" ip saddr ${lan_subnet} accept
          iifname "tailscale0" oifname "eth1" ip daddr ${lan_subnet} accept
        }

        chain postrouting {
          type nat hook postrouting priority srcnat; policy accept;
          oifname "eth0" ip saddr ${lan_subnet} masquerade
        }
      }

package_update: true

packages:
  - openssh
  - sudo
  - python3
  - nftables
  - nftables-openrc
  - tailscale
  - tailscale-openrc

runcmd:
  - |
      set -eu

      rc-update add sysctl boot
      sysctl -p /etc/sysctl.d/99-router.conf

      nft -c -f /etc/nftables.nft
      rc-update add nftables boot
      rc-service nftables start

      rc-update add tailscale default
      rc-service tailscale start

      tailscale up \
        --auth-key=file:/root/tailscale-auth-key \
        --advertise-routes=${lan_subnet} \
        --accept-routes=true \
        --snat-subnet-routes=false \
        --accept-dns=false \
        --netfilter-mode=on \
        --ssh=false \
        --timeout=120s

      rm -f /root/tailscale-auth-key

      sed -i '/^ListenAddress 127\.0\.0\.1$/d' /etc/ssh/sshd_config

      ssh-keygen -A
      sshd -t
      rc-update add sshd default
      rc-service sshd restart

