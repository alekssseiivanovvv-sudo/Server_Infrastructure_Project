[Unit]
Description=SeaweedFS Volume
After=network-online.target seaweed-master.service
Wants=network-online.target seaweed-master.service

[Service]
User={{ seaweed_admin_user }}
Group={{ seaweed_admin_user }}
ExecStart=/usr/local/bin/weed volume -mserver=127.0.0.1:9333 -ip=127.0.0.1 -ip.bind=127.0.0.1 -port=8080 -port.grpc=18080 -dir={{ seaweed_data_dir }}/volume -max={{ seaweed_volume_max }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
