[Unit]
Description=SeaweedFS Master
After=network-online.target
Wants=network-online.target

[Service]
User={{ seaweed_admin_user }}
Group={{ seaweed_admin_user }}
ExecStart=/usr/local/bin/weed master -ip=127.0.0.1 -ip.bind=127.0.0.1 -port=9333 -port.grpc=19333 -mdir={{ seaweed_data_dir }}/master -defaultReplication=000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
