global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

{% if groups['node_exporter_agents'] is defined %}
  - job_name: node_exporter
    static_configs:
      - targets:
{% for host in groups['node_exporter_agents'] %}
          - {{ hostvars[host].ansible_host }}:9100
{% endfor %}
{% endif %}
