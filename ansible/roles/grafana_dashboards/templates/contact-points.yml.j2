apiVersion: 1

contactPoints:
  - orgId: 1
    name: telegram
    receivers:
      - uid: telegram-alerts
        type: telegram
        disableResolveMessage: false
        settings:
          bottoken: "{{ grafana_telegram_bot_token }}"
          chatid: "{{ grafana_telegram_chat_id }}"
          parse_mode: HTML
          message: |-
{% raw %}            {{ range .Alerts }}{{ if eq .Status "firing" }}🔴{{ else }}✅{{ end }} <b>{{ .Labels.alertname }}</b> [{{ .Labels.severity }}]
            {{ .Annotations.summary }}
            {{ end }}
{% endraw %}
