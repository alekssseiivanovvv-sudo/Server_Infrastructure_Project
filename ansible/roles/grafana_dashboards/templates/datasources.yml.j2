apiVersion: 1

datasources:
  - name: Prometheus
    uid: prometheus-uid
    type: prometheus
    access: proxy
    url: http://localhost:9090
    isDefault: true
    editable: false
    jsonData:
      timeInterval: "15s"

  - name: Loki
    uid: loki-uid
    type: loki
    access: proxy
    url: http://localhost:3100
    editable: false
