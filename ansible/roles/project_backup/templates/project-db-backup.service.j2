[Unit]
Description=Backup current Patroni Primary database to Restic
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/srv/backup

[Service]
Type=oneshot
User={{ backup_restic_user }}
Group={{ backup_restic_user }}
UMask=0077
Environment=PGPASSFILE={{ backup_postgres_password_file }}
Environment=RESTIC_PASSWORD_FILE={{ backup_restic_password_file }}
Environment=XDG_CACHE_HOME={{ backup_cache_dir }}
ExecStartPre=/usr/bin/mountpoint -q /srv/backup
ExecStart=/usr/local/sbin/project-db-backup
TimeoutStartSec=30min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/backup {{ backup_work_dir }}
