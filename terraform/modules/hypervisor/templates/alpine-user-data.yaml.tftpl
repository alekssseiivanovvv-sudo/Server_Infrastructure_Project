#cloud-config
hostname: ${jsonencode(hostname)}
manage_etc_hosts: true

users:
  - name: ansible_admin
    groups: [wheel]
    shell: /bin/ash
    lock_passwd: false
    hashed_passwd: ${jsonencode(admin_password_hash)}
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${jsonencode(ansible_public_key)}

disable_root: true
ssh_pwauth: false

growpart:
  mode: auto
  devices: ["/"]

resize_rootfs: true

write_files:
  - path: /etc/resolv.conf
    permissions: "0644"
    content: |
      nameserver 1.1.1.1
      nameserver 9.9.9.9

  - path: /etc/apk/repositories
    permissions: "0644"
    content: |
      https://dl-cdn.alpinelinux.org/alpine/v3.24/main
      https://dl-cdn.alpinelinux.org/alpine/v3.24/community

  - path: /etc/ssh/sshd_config
    permissions: "0600"
    content: |
      Port ${ssh_port}
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PubkeyAuthentication yes
      AuthorizedKeysFile .ssh/authorized_keys
      AllowUsers ansible_admin
      Subsystem sftp internal-sftp

package_update: true

packages:
  - openssh
  - sudo
  - python3

runcmd:
  - |
      set -eu
      ssh-keygen -A
      sshd -t
      rc-update add sshd default
      rc-service sshd start

