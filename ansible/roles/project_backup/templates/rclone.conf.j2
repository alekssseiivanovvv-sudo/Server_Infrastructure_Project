[{{ backup_s3_remote_name }}]
type = s3
provider = Other
env_auth = false
access_key_id = {{ vault_garage_backup_access_key }}
secret_access_key = {{ vault_garage_backup_secret_key }}
region = {{ backup_s3_region }}
endpoint = {{ backup_s3_endpoint }}
force_path_style = true
acl = private
bucket_acl = private
